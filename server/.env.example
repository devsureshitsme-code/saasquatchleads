# Postgres (local docker-compose, Neon, or Supabase). Run `npm run db:migrate` once.
DATABASE_URL="postgresql://saasquatchleads:saasquatchleads@localhost:5432/saasquatchleads"
# Set to "true" for hosted Postgres that requires TLS (Neon, Supabase, Render)
DATABASE_SSL=false

# Redis (local docker-compose or Upstash "rediss://..." URL). Optional: falls back to in-memory cache.
REDIS_URL="redis://localhost:6379"

PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:3000"

# Set to "false" to skip live website checks (faster, works offline)
CHECK_WEBSITES=true
# Max concurrent network lookups during validation
VALIDATION_CONCURRENCY=20

# ---- Company Finder (search by industry + location) ----
# Google Places API (New). Best data (phone, website, rating, reviews). Optional.
# Create at console.cloud.google.com -> APIs & Services -> enable "Places API (New)" -> Credentials -> API key.
GOOGLE_PLACES_API_KEY=""
# OpenStreetMap is free and needs no key; set to "true" to turn it off.
DISABLE_OSM=false

# ---- AI (optional) ----
# Reads company websites, parses plain-English searches, drafts outreach.
# AI_PROVIDER: groq | gemini | openrouter | openai | anthropic | custom
#   groq      free tier, fast. Key: console.groq.com/keys          (default model openai/gpt-oss-20b)
#   gemini    free tier.       Key: aistudio.google.com/apikey     (default model gemini-3.8-flash)
#   openrouter                 Key: openrouter.ai/keys  (":free" models ~50 requests/day without credits)
#   openai / anthropic         paid keys
#   custom    any OpenAI-compatible server; set AI_BASE_URL (e.g. http://localhost:11434/v1 for Ollama)
AI_PROVIDER="groq"
AI_API_KEY=""
# Optional overrides
AI_MODEL=""
AI_BASE_URL=""
# Free-tier friendly defaults: requests per minute, parallel calls, and max AI reads per search
AI_RPM=""
AI_CONCURRENCY=2
AI_MAX_PER_JOB=40
